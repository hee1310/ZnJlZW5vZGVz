<script>
/* ===== ME.LOL — product drop gate: block purchase before start AND after end V533 ===== */
(function(){
  if(location.pathname.indexOf('/products/')!==0) return;
  if(!window.MELOLDrops) return;
  if(window.__melolDropGate) return; window.__melolDropGate=true;

  function curDomain(){
    try{ var p=new URLSearchParams(location.search).get('domain'); return (p||sessionStorage.getItem('melol_domain')||'me.lol').toLowerCase(); }
    catch(e){ return 'me.lol'; }
  }
  function buyButtons(){ return document.querySelectorAll('button[name="add"], .product-form__submit, .add-to-cart-button, .shopify-payment-button, .shopify-payment-button__button, [data-shopify="payment-button"], shopify-accelerated-checkout, .shop-pay-wallet-button'); }
  function pad(n){ return (n<10?'0':'')+n; }

  var gated=false, mode='', target=null, startDate=null, startLabel='', _apply=null, _count=null;

  function buildPanel(){
    if(document.getElementById('melolDropGate')) return;
    var anchor=document.querySelector('.product-form, form[action*="/cart/add"]')||document.querySelector('h1');
    if(!anchor||!anchor.parentNode) return;
