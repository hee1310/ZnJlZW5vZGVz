<script>
/* ===== V558 PIECE 2 — CART THUMBNAIL via the SAME render math + SAVE knobs as the product page =====
   Feeds line-item DATA (domain, finger, style) into the exact renderSave() math so the cart
   shirt matches the product page / download. One knob set (SAVE below, kept in sync with the
   Overlay Tuner) drives it. Rendered at 1200px, displayed small in the thumbnail. ===== */
(function(){
  if(location.pathname.indexOf('/cart')!==0) return;
  if(window.__melolCartThumbs) return; window.__melolCartThumbs=true;
  window.__melolRenderShirt=null; /* set below */

  var SHIRT='https://cdn.shopify.com/s/files/1/0714/1697/1451/files/FinalFlatShirt.png';
  var YOU='https://cdn.shopify.com/s/files/1/0714/1697/1451/files/Pointing_finger_BGRM.png';
  var ME='https://cdn.shopify.com/s/files/1/0714/1697/1451/files/FINAL_CROP_png_transparent_flat_horiz.png?v=1781213954';
  var FINGER_VARIANTS={'47635674169531':1,'47635674235067':1,'47635674300603':1,'47635674366139':1,'47635674431675':1,'47635674497211':1,'47973498421435':1};

  /* KNOBS — mirror the product page's SAVE block. Uses the DESKTOP tuning (a thumbnail is one
     fixed render, not device-responsive). Keep in sync if you retune the product page SAVE. */
  var K = {
    size: 1200,
    finger: {
      size: { me: 185, you: 310 },                 // px (desktop SAVE values)
      pos:  { me: {x:1.90,y:22.75}, you:{x:0.00,y:21.25} }   // x=% from center, y=% from top
    },
    word: { size: 90, y: 38.75, fitPct: 32 },
    tld:  { size: 35, gap: -0.1 },
    noFingerShift: 13                              // % lift when no finger
  };

  var _cache={};
  var SPECIAL_GRAPHICS={'usa.lol':'https://cdn.shopify.com/s/files/1/0714/1697/1451/files/usa.lol.dumpsterfire.png?v=1780805700'};
  /* special-graphic sizing (dumpster fire is bulkier than the finger -> smaller box + its own Y).
     TUNE HERE if a special graphic overlaps the text. box=px on the 1200 canvas, y=% from top. */
  var SPECIAL_SIZE={ 'usa.lol':{ boxPct:16.6, y:22 } };   /* V610: same ratio as all other paths */

  function rowDomain(r){
    var p=r.querySelectorAll('.cart-items__property');
    for(var i=0;i<p.length;i++){ var dt=(p[i].querySelector('dt')||{}).textContent||''; if(/domain name/i.test(dt)) return (((p[i].querySelector('dd')||{}).textContent)||'').trim().toLowerCase(); }
    return '';
  }
  function rowHasFinger(r){ var k=r.getAttribute('data-key')||''; return !!FINGER_VARIANTS[String(k).split(':')[0]]; }
  function rowStyle(r){
    var p=r.querySelectorAll('.cart-items__property');
    for(var i=0;i<p.length;i++){ var dt=(p[i].querySelector('dt')||{}).textContent||''; if(/finger style/i.test(dt)) return (((p[i].querySelector('dd')||{}).textContent)||'').trim().toUpperCase(); }
    return '';
  }

  function loadImg(src){ return new Promise(function(res){ var im=new Image(); im.crossOrigin='anonymous'; im.onload=function(){res(im);}; im.onerror=function(){res(null);}; im.src=src; }); }

  function render(domain, finger, style, cb){
    var key=domain+'|'+finger+'|'+style+'|sg';
    if(_cache[key]){ cb(_cache[key]); return; }
    var dot=domain.lastIndexOf('.');
    var wordTxt=(dot>-1?domain.slice(0,dot):domain).toUpperCase();
    var tldTxt=(dot>-1?domain.slice(dot):'').toUpperCase(); if(tldTxt==='.WTF'||tldTxt==='.SO'||tldTxt==='.TO') tldTxt+='?';
    var st=(style==='ME')?'me':'you';
    var size=K.size;
    var special=SPECIAL_GRAPHICS[(domain||'').toLowerCase()];
    var fingerSrc = finger ? (special ? special : (st==='me'?ME:YOU)) : null;
    Promise.all([loadImg(SHIRT), fingerSrc?loadImg(fingerSrc):Promise.resolve(null)]).then(function(imgs){
      var shirt=imgs[0], fimg=imgs[1];
      var cv=document.createElement('canvas'); cv.width=size; cv.height=size;
      var ctx=cv.getContext('2d');
      ctx.fillStyle='#f0f0f0'; ctx.fillRect(0,0,size,size);
      if(shirt) ctx.drawImage(shirt,0,0,size,size);
      // finger OR special graphic
      if(fimg&&fimg.naturalWidth){
        var ss=special?SPECIAL_SIZE[(domain||'').toLowerCase()]:null;
        var box, boxTop, cx;
        if(ss){                                   // special graphic: own size + centered + own Y
          box=(ss.boxPct/100)*size; cx=size/2; boxTop=(ss.y/100)*size;
        } else {                                   // finger: the usual knobs
          box=K.finger.size[st]||K.finger.size.you;
          var p=K.finger.pos[st]||K.finger.pos.you;
