<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edge Storage Console · HK-01 (Demo)</title>
  <style>
    :root {
      color-scheme: light dark;

      /* Theme variables (default dark) */
      --bg1: #0f172a;
      --bg2: #020617;
      --panel: rgba(15,23,42,0.92);
      --panel2: rgba(15,23,42,0.8);
      --border: rgba(148,163,184,0.2);
      --border2: rgba(148,163,184,0.32);
      --text: #e5e7eb;
      --muted: #9ca3af;
      --muted2: #6b7280;
      --shadow: rgba(15,23,42,0.7);
      --accent1: #2563eb;
      --accent2: #0ea5e9;
      --ok: #22c55e;
      --warn: #eab308;
      --err: #ef4444;
    }

    html[data-theme="light"] {
      color-scheme: light;
      --bg1: #f1f5f9;
      --bg2: #e2e8f0;
      --panel: rgba(255,255,255,0.88);
      --panel2: rgba(255,255,255,0.75);
      --border: rgba(15,23,42,0.16);
      --border2: rgba(15,23,42,0.12);
      --text: #0b1220;
      --muted: rgba(15,23,42,0.65);
      --muted2: rgba(15,23,42,0.5);
      --shadow: rgba(15,23,42,0.12);
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: radial-gradient(circle at top left, var(--bg1) 0, var(--bg2) 40%);
      color: var(--text);
    }

    .layout {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
      background: color-mix(in srgb, var(--panel) 92%, transparent);
      border-right: 1px solid color-mix(in srgb, var(--border) 90%, transparent);
      padding: 18px 14px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: auto;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 4px 6px 10px;
      border-bottom: 1px solid color-mix(in srgb, var(--border) 90%, transparent);
    }
    .brand-icon {
      width: 26px; height: 26px; border-radius: 8px;
      background: radial-gradient(circle at 30% 20%, #38bdf8, #1d4ed8);
      display: flex; align-items: center; justify-content: center;
      font-size: 16px;
      color: white;
    }
    .brand-text { display: flex; flex-direction: column; gap: 2px; }
    .brand-name { font-size: 14px; font-weight: 650; }
    .brand-sub { font-size: 11px; color: var(--muted); }
    .menu { margin-top: 6px; display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
    .menu-section-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted2);
      margin: 8px 4px 2px;
    }
    .menu-item {
      padding: 8px 10px;
      border-radius: 8px;
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      user-select: none;
    }
    .menu-item:hover { background: color-mix(in srgb, var(--border) 25%, transparent); }
    .menu-item.active {
      background: linear-gradient(90deg, color-mix(in srgb, var(--accent1) 35%, transparent), color-mix(in srgb, var(--accent2) 22%, transparent));
      color: var(--text);
    }
    .menu-item span:first-child { display: flex; align-items: center; gap: 8px; }
    .menu-item .badge {
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--panel2) 80%, transparent);
      border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
      color: var(--text);
    }
    .sidebar-footer {
      margin-top: auto;
      font-size: 11px;
      color: var(--muted2);
      border-top: 1px solid color-mix(in srgb, var(--border) 90%, transparent);
      padding-top: 8px;
    }
    .sidebar-footer strong { color: var(--text); }

    /* Main */
    .main {
      padding: 14px 22px 22px;
      background: radial-gradient(circle at top center, color-mix(in srgb, var(--accent1) 16%, transparent), transparent 55%);
      min-width: 0;
    }

    /* Top bar */
    .top-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; }
    .top-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .top-title { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .top-title-main { font-size: 18px; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .top-title-sub { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .top-right { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); flex-wrap: wrap; justify-content: flex-end; }
    .top-right-time { font-variant-numeric: tabular-nums; min-width: 175px; text-align: right; }

    .pill {
      border-radius: 999px;
      border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
      padding: 4px 10px;
      display: flex;
      align-items: center;
      gap: 6px;
      background: color-mix(in srgb, var(--panel2) 85%, transparent);
      white-space: nowrap;
      color: var(--text);
    }
    .pill-dot { width: 7px; height: 7px; border-radius: 999px; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 25%, transparent); }

    /* Buttons / inputs */
    .btn {
      border-radius: 999px;
      border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
      background: color-mix(in srgb, var(--panel2) 85%, transparent);
      color: var(--text);
      font-size: 12px;
      padding: 8px 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      transition: transform .05s ease, opacity .2s ease;
      touch-action: manipulation;
    }
    .btn-primary {
      border-color: color-mix(in srgb, var(--accent1) 70%, transparent);
      background: linear-gradient(90deg, var(--accent1), var(--accent2));
      color: white;
    }
    .btn-ghost {
      background: transparent;
      border-color: color-mix(in srgb, var(--border) 55%, transparent);
    }
    .btn:active { transform: translateY(0.5px); }
    .btn[disabled] { opacity: .55; cursor: not-allowed; }

    .input {
      border-radius: 10px;
      border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
      background: color-mix(in srgb, var(--panel2) 85%, transparent);
      color: var(--text);
      font-size: 13px;
      padding: 10px 10px;
      min-width: 0;
      outline: none;
    }
    .input:focus {
      border-color: color-mix(in srgb, var(--accent2) 75%, transparent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent2) 20%, transparent);
    }
    .select {
      border-radius: 999px;
      border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
      background: color-mix(in srgb, var(--panel2) 85%, transparent);
      color: var(--text);
      font-size: 12px;
      padding: 8px 10px;
      cursor: pointer;
    }

    /* Grid + cards */
    .grid { display: grid; grid-template-columns: minmax(0, 2.3fr) minmax(290px, 1.2fr); gap: 16px; }
    .card {
      background: var(--panel);
      border-radius: 14px;
      border: 1px solid color-mix(in srgb, var(--border) 90%, transparent);
      box-shadow: 0 18px 45px var(--shadow);
      padding: 14px 16px 12px;
      min-width: 0;
    }
    .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 10px; }
    .card-title { font-size: 13px; font-weight: 600; }
    .card-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
    .card-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .right-section { display: flex; flex-direction: column; gap: 12px; }

    /* Stats */
    .stats-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-bottom: 10px; }
    .stat-block {
      padding: 10px 10px;
      border-radius: 12px;
      background: radial-gradient(circle at top left, color-mix(in srgb, var(--accent1) 18%, transparent), color-mix(in srgb, var(--panel) 92%, transparent));
      border: 1px solid color-mix(in srgb, var(--border2) 95%, transparent);
      min-width: 0;
    }
    .stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 3px; }
    .stat-value { font-size: 18px; font-weight: 700; }
    .stat-extra { font-size: 11px; color: var(--muted); }
    .bar { margin-top: 6px; height: 6px; border-radius: 999px; background: color-mix(in srgb, var(--bg2) 60%, transparent); overflow: hidden; }
    .bar-fill { height: 100%; background-image: linear-gradient(90deg, var(--ok), var(--warn)); }

    /* Table */
    .table-toolbar {
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      margin: 10px 0 10px;
    }
    .table-toolbar-left { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .table-toolbar-right { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

    .table-wrapper {
      border-radius: 12px;
      background: color-mix(in srgb, var(--panel2) 90%, transparent);
      border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
      overflow: auto;
      -webkit-overflow-scrolling: touch;
    }
    table { width: 100%; border-collapse: collapse; font-size: 12px; min-width: 720px; }
    thead { background: color-mix(in srgb, var(--panel) 95%, transparent); position: sticky; top: 0; }
    th, td { padding: 10px 10px; text-align: left; vertical-align: middle; }
    th { font-weight: 600; color: var(--muted); border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    tbody tr:nth-child(odd) { background: color-mix(in srgb, var(--panel2) 72%, transparent); }
    tbody tr:nth-child(even) { background: color-mix(in srgb, var(--panel2) 88%, transparent); }

    .file-name { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .file-main { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .file-main .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .file-tag { font-size: 10px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--border) 70%, transparent); padding: 1px 6px; color: var(--muted); flex: 0 0 auto; }
    .file-desc { font-size: 10px; color: var(--muted2); }

    .pagination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 10px;
    }
    .pager {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }
    .page-info { font-size: 12px; color: var(--muted); }

    /* KV */
    .kv-row { display: flex; flex-direction: column; gap: 4px; font-size: 12px; }
    .kv-row span:first-child { color: var(--muted); }
    .divider { border-top: 1px dashed color-mix(in srgb, var(--border) 75%, transparent); margin: 10px 0; }

    /* Login box */
    .login-box {
      margin-top: 4px;
      padding: 12px 12px 10px;
      border-radius: 12px;
      background: radial-gradient(circle at top left, color-mix(in srgb, var(--accent1) 18%, transparent), color-mix(in srgb, var(--panel) 96%, transparent));
      border: 1px solid color-mix(in srgb, var(--accent1) 55%, transparent);
      font-size: 12px;
    }
    .login-inputs {
      margin-top: 10px;
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      gap: 10px;
    }
    .login-muted { margin-top: 6px; font-size: 11px; color: var(--muted); }

    /* Logs */
    .log-box {
      height: 220px;
      border-radius: 12px;
      border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
      background: color-mix(in srgb, var(--panel2) 92%, transparent);
      overflow: auto;
      padding: 10px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 12px;
      line-height: 1.45;
      -webkit-overflow-scrolling: touch;
    }
    .log-line { color: var(--text); opacity: .92; }
    .log-line .t { color: var(--muted); margin-right: 8px; }
    .log-line .lvl { display: inline-block; width: 52px; }
    .lvl.ok { color: var(--ok); }
    .lvl.warn { color: var(--warn); }
    .lvl.err { color: var(--err); }

    .footer { margin-top: 10px; font-size: 11px; color: var(--muted2); text-align: right; }

    /* Mobile drawer */
    .hamburger {
      display: none;
      border-radius: 10px;
      padding: 8px 10px;
      line-height: 1;
    }
    .drawer-backdrop {
      position: fixed; inset: 0;
      background: rgba(0,0,0,.45);
      opacity: 0; pointer-events: none;
      transition: opacity .2s ease;
      z-index: 40;
    }
    .drawer {
      position: fixed;
      top: 0; left: 0; height: 100%;
      width: 86vw; max-width: 320px;
      transform: translateX(-105%);
      transition: transform .2s ease;
      z-index: 50;
    }
    .drawer.open { transform: translateX(0); }
    .drawer-backdrop.open { opacity: 1; pointer-events: auto; }

    /* Notification center drawer (right) */
    .notify-backdrop {
      position: fixed; inset: 0;
      background: rgba(0,0,0,.45);
      opacity: 0; pointer-events: none;
      transition: opacity .2s ease;
      z-index: 60;
    }
    .notify-drawer {
      position: fixed;
      top: 0; right: 0; height: 100%;
      width: min(420px, 92vw);
      transform: translateX(105%);
      transition: transform .2s ease;
      z-index: 70;
      background: var(--panel);
      border-left: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
      box-shadow: -18px 0 45px var(--shadow);
      padding: 14px 14px 12px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .notify-backdrop.open { opacity: 1; pointer-events: auto; }
    .notify-drawer.open { transform: translateX(0); }

    .notify-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .notify-title { font-size: 14px; font-weight: 700; }
    .notify-list {
      flex: 1 1 auto;
      overflow: auto;
      -webkit-overflow-scrolling: touch;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-right: 4px;
    }
    .notify-item {
      border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
      border-radius: 12px;
      background: color-mix(in srgb, var(--panel2) 92%, transparent);
      padding: 10px 10px;
      font-size: 12px;
    }
    .notify-item.unread { border-color: color-mix(in srgb, var(--accent2) 55%, transparent); }
    .notify-item .meta { color: var(--muted); font-size: 11px; margin-top: 4px; display: flex; justify-content: space-between; gap: 8px; }

    .icon-btn {
      position: relative;
      border-radius: 999px;
      padding: 8px 10px;
    }
    .unread-badge {
      position: absolute;
      top: 2px;
      right: 2px;
      min-width: 18px;
      height: 18px;
      padding: 0 5px;
      border-radius: 999px;
      background: var(--err);
      color: white;
      font-size: 11px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 2px solid color-mix(in srgb, var(--panel) 100%, transparent);
    }

    /* Toast */
    .toast-wrap {
      position: fixed;
      bottom: 14px; left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      gap: 8px;
      z-index: 100;
      width: min(560px, calc(100vw - 24px));
    }
    .toast {
      border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
      background: color-mix(in srgb, var(--panel) 92%, transparent);
      border-radius: 14px;
      padding: 10px 12px;
      box-shadow: 0 18px 45px var(--shadow);
      font-size: 12px;
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }
    .toast strong { font-weight: 750; }
    .toast small { color: var(--muted); display: block; margin-top: 2px; }
    .toast .dot {
      width: 10px; height: 10px; border-radius: 999px;
      margin-top: 3px;
      background: var(--ok);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 22%, transparent);
      flex: 0 0 auto;
    }
    .toast.warn .dot { background: var(--warn); box-shadow: 0 0 0 4px color-mix(in srgb, var(--warn) 22%, transparent); }
    .toast.err .dot  { background: var(--err);  box-shadow: 0 0 0 4px color-mix(in srgb, var(--err)  22%, transparent); }

    /* Responsive */
    @media (max-width: 880px) {
      .layout { grid-template-columns: minmax(0, 1fr); }
      .sidebar.desktop { display: none; }
      .hamburger { display: inline-flex; }
      .top-right-time { min-width: auto; }
      .grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .main { padding: 12px 12px 18px; }
      .stats-row { grid-template-columns: 1fr; }
      .login-inputs { grid-template-columns: 1fr; }
      .card-actions { justify-content: flex-start; }
      .top-right { justify-content: flex-end; }
      .top-right-time { text-align: left; }
    }
  </style>
</head>

<body>
  <!-- Mobile nav drawer -->
  <div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
  <aside class="sidebar drawer" id="drawer" aria-label="Navigation drawer">
    <div class="brand">
      <div class="brand-icon">?</div>
      <div class="brand-text">
        <div class="brand-name">Edge Storage</div>
        <div class="brand-sub" data-i18n="brandSub">Node HK-01 · demo mode</div>
      </div>
    </div>

    <div class="menu" id="menu-mobile">
      <div class="menu-section-title" data-i18n="menuOverview">Overview</div>
      <div class="menu-item active" data-nav="dashboard">
        <span><span>●</span> <span data-i18n="navDashboard">Dashboard</span></span><span class="badge">LIVE</span>
      </div>
      <div class="menu-item" data-nav="volumes"><span><span>?</span> <span data-i18n="navVolumes">Volumes</span></span></div>
      <div class="menu-item" data-nav="logs"><span><span>?</span> <span data-i18n="navLogs">Logs</span></span></div>

      <div class="menu-section-title" data-i18n="menuNode">Node</div>
      <div class="menu-item" data-nav="interfaces"><span><span>?</span> <span data-i18n="navInterfaces">Interfaces</span></span></div>
      <div class="menu-item" data-nav="maintenance"><span><span>?</span> <span data-i18n="navMaintenance">Maintenance</span></span></div>
    </div>

    <div class="sidebar-footer">
      <span data-i18n="connectedAs">Connected as</span> <strong>guest</strong><br />
      <span data-i18n="uptime">Node uptime</span>: <span id="uptime-text">–</span>
    </div>
  </aside>

  <!-- Notifications drawer -->
  <div class="notify-backdrop" id="notify-backdrop" aria-hidden="true"></div>
  <aside class="notify-drawer" id="notify-drawer" aria-label="Notification center">
    <div class="notify-header">
      <div class="notify-title" data-i18n="notifyTitle">Notification Center</div>
      <div style="display:flex; gap:8px; align-items:center;">
        <button class="btn btn-ghost" id="btn-mark-all" type="button" data-i18n="markAll">Mark all read</button>
        <button class="btn" id="btn-close-notify" type="button" aria-label="Close">?</button>
      </div>
    </div>

    <div class="notify-list" id="notify-list"></div>

    <div style="display:flex; gap:8px; justify-content:flex-end; flex-wrap:wrap;">
      <button class="btn btn-ghost" id="btn-clear-notify" type="button" data-i18n="clearAll">Clear all</button>
      <button class="btn btn-primary" id="btn-add-notify" type="button" data-i18n="addTestNotify">Add test</button>
    </div>
  </aside>

  <div class="layout">
    <!-- Desktop sidebar -->
    <aside class="sidebar desktop" aria-label="Sidebar navigation">
      <div class="brand">
        <div class="brand-icon">?</div>
        <div class="brand-text">
          <div class="brand-name">Edge Storage</div>
          <div class="brand-sub" data-i18n="brandSub">Node HK-01 · demo mode</div>
        </div>
      </div>

      <div class="menu" id="menu-desktop">
        <div class="menu-section-title" data-i18n="menuOverview">Overview</div>
        <div class="menu-item active" data-nav="dashboard">
          <span><span>●</span> <span data-i18n="navDashboard">Dashboard</span></span><span class="badge">LIVE</span>
        </div>
        <div class="menu-item" data-nav="volumes"><span><span>?</span> <span data-i18n="navVolumes">Volumes</span></span></div>
        <div class="menu-item" data-nav="logs"><span><span>?</span> <span data-i18n="navLogs">Logs</span></span></div>

        <div class="menu-section-title" data-i18n="menuNode">Node</div>
        <div class="menu-item" data-nav="interfaces"><span><span>?</span> <span data-i18n="navInterfaces">Interfaces</span></span></div>
        <div class="menu-item" data-nav="maintenance"><span><span>?</span> <span data-i18n="navMaintenance">Maintenance</span></span></div>
      </div>

      <div class="sidebar-footer">
        <span data-i18n="connectedAs">Connected as</span> <strong>guest</strong><br />
        <span data-i18n="uptime">Node uptime</span>: <span id="uptime-text-desktop">–</span>
      </div>
    </aside>

    <main class="main">
      <header class="top-bar">
        <div class="top-left">
          <button class="btn hamburger" id="hamburger" type="button" aria-label="Open menu">?</button>
          <div class="top-title">
            <div class="top-title-main" data-i18n="topTitle">Node status · HK-01</div>
            <div class="top-title-sub" data-i18n="topSub"></div>
          </div>
        </div>

        <div class="top-right">
