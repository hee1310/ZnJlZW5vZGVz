    if(pos!=='relative'&&pos!=='absolute') media.style.position='relative';
    var old=media.querySelector('.melol-mal-ov'); if(old&&old.parentNode) old.parentNode.removeChild(old);
    var dot=domain.lastIndexOf('.');
