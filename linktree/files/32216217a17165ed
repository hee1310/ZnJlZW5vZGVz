      return FILES.filter(f =>
        (f.name + " " + f.tag + " " + f.desc + " " + f.activity + " " + f.size)
          .toLowerCase()
          .includes(q)
      );
    }
    function totalPages() {
      const total = filteredFiles().length;
      return Math.max(1, Math.ceil(total / pageSize()));
    }
    function clampPage() {
      page = Math.min(Math.max(1, page), totalPages());
    }

    function renderTable() {
      clampPage();
      const lang = currentLang();
      const tbody = document.getElementById("file-tbody");
      const list = filteredFiles();
      const start = (page - 1) * pageSize();
      const end = start + pageSize();
      const rows = list.slice(start, end);

      tbody.innerHTML = "";
      if (rows.length === 0) {
        const tr = document.createElement("tr");
        tr.innerHTML = `<td colspan="4" style="padding:16px; color: var(--muted);">
          ${lang==="zh" ? "没有匹配结果" : "No results found"}
        </td>`;
        tbody.appendChild(tr);
        return;
      }

      for (const f of rows) {
        const tr = document.createElement("tr");
        const actionLabel = (lang==="zh")
          ? (f.kind === "button" ? "解锁" : (f.actionText === "Open" ? "打开" : "下载"))
          : f.actionText;

        tr.innerHTML = `
          <td>
            <div class="file-name">
              <div class="file-main">
                <span class="name">${escapeHtml(f.name)}</span>
                <span class="file-tag">${escapeHtml(f.tag)}</span>
              </div>
              <div class="file-desc">${escapeHtml(f.desc)}</div>
            </div>
          </td>
          <td>${escapeHtml(f.activity)}</td>
          <td>${escapeHtml(f.size)}</td>
          <td style="text-align:right; white-space:nowrap;">
            ${
              f.kind === "link"
                ? `<a class="btn" href="${escapeHtml(f.href)}" target="_blank" rel="noopener">${escapeHtml(actionLabel)}</a>`
                : `<button class="btn" type="button" data-action="unlock">${escapeHtml(actionLabel)}</button>`
            }
          </td>
        `;
        tr.querySelector('[data-action="unlock"]')?.addEventListener("click", async () => {
          toast(lang==="zh" ? "解锁" : "Unlock", lang==="zh" ? "访客会话无权限（）" : "Guest has no permission (demo)", "err", 2400);
          addLog("WARN", lang==="zh" ? "unlock denied: guest session" : "unlock denied: guest session");
          addNotification(lang==="zh" ? "访问被拒绝" : "Access denied",
                          lang==="zh" ? "访客尝试解锁受保护归档（已阻止）。" : "Guest attempted to unlock protected archive (blocked).",
                          true);
        });
        tbody.appendChild(tr);
      }
    }

    function updatePageInfo() {
      clampPage();
      const lang = currentLang();
      const total = filteredFiles().length;
      const tp = totalPages();
      const start = total === 0 ? 0 : (page - 1) * pageSize() + 1;
      const end = Math.min(total, (page - 1) * pageSize() + pageSize());

      document.getElementById("page-info").textContent =
        lang === "zh"
          ? `第 ${page} / ${tp} 页 · 显示 ${start}-${end} / ${total}`
          : `Page ${page} / ${tp} · Showing ${start}-${end} of ${total}`;
    }

    document.getElementById("search-input").addEventListener("input", () => {
      page = 1;
      renderTable(); updatePageInfo();
    });
    document.getElementById("page-size").addEventListener("change", () => {
      page = 1;
      renderTable(); updatePageInfo();
    });
    document.getElementById("btn-prev").addEventListener("click", () => {
      page--; renderTable(); updatePageInfo();
    });
    document.getElementById("btn-next").addEventListener("click", () => {
      page++; renderTable(); updatePageInfo();
    });
    document.getElementById("btn-reset-filter").addEventListener("click", () => {
      document.getElementById("search-input").value = "";
      page = 1;
      renderTable(); updatePageInfo();
      toast(currentLang()==="zh" ? "已重置" : "Reset", currentLang()==="zh" ? "已清空过滤条件" : "Filters cleared", "ok", 1400);
    });

    /* --------------------------
      Buttons simulate
    --------------------------- */
    function withLoading(btn, task) {
      const old = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = (currentLang()==="zh" ? "处理中…" : "Working…");
      return Promise.resolve()
        .then(task)
        .finally(() => {
          btn.disabled = false;
          btn.innerHTML = old;
        });
    }

    document.getElementById("btn-check").addEventListener("click", (e) => {
      const btn = e.currentTarget;
      withLoading(btn, async () => {
        toast(currentLang()==="zh" ? "检查更新" : "Update check",
              currentLang()==="zh" ? "正在联系更新服务器（）…" : "Contacting update server (demo)…",
              "warn", 1200);
        addLog("INFO", currentLang()==="zh" ? "update check started" : "update check started");
        await sleep(850);
        toast(currentLang()==="zh" ? "已是最新" : "Up to date",
              currentLang()==="zh" ? "未发现可用更新（）。" : "No updates available (demo).",
              "ok");
        addLog("OK", currentLang()==="zh" ? "update check: up to date" : "update check: up to date");
      });
    });

    document.getElementById("btn-restart").addEventListener("click", (e) => {
      const btn = e.currentTarget;
      withLoading(btn, async () => {
        toast(currentLang()==="zh" ? "重启请求" : "Restart requested",
              currentLang()==="zh" ? "已进入队列，将在低负载窗口执行（）" : "Queued for low-load window (demo)",
              "warn", 1600);
        addLog("WARN", currentLang()==="zh" ? "restart queued (demo)" : "restart queued (demo)");
        addNotification(currentLang()==="zh" ? "维护计划" : "Maintenance scheduled",
                        currentLang()==="zh" ? "节点重启已排队（，不会真实执行）。" : "Node restart queued (demo, not executed).",
                        true);
        await sleep(900);
        toast(currentLang()==="zh" ? "模式" : "Demo mode",
              currentLang()==="zh" ? "未执行真实重启。" : "No real restart executed.",
              "err", 2400);
        addLog("ERR", currentLang()==="zh" ? "restart blocked: demo mode" : "restart blocked: demo mode");
      });
    });

    /* --------------------------
      Login (inputs are now editable)
    --------------------------- */
    document.getElementById("btn-signin").addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const lang = currentLang();
      const u = document.getElementById("username").value.trim();
      const p = document.getElementById("password").value;

      await withLoading(btn, async () => {
        if (!u || p.length < 4) {
          toast(lang==="zh" ? "登录失败" : "Sign-in failed",
                lang==="zh" ? "请输入用户名，且密码至少 4 位（校验）。" : "Enter a username and a password ≥ 4 chars (demo check).",
                "err", 2400);
          addLog("WARN", "signin rejected (demo validation)");
          return;
        }
        toast(lang==="zh" ? "正在登录" : "Signing in",
              lang==="zh" ? "本地校验中…" : "Local demo validation…",
              "warn", 1200);
        addLog("INFO", `signin attempt user="${u}" (demo)`);
        await sleep(900);
        toast(lang==="zh" ? "登录成功" : "Signed in",
              lang==="zh" ? `欢迎，${u}（会话）` : `Welcome, ${u} (demo session)`,
              "ok", 2200);
        addNotification(lang==="zh" ? "会话已建立" : "Session created",
                        lang==="zh" ? `用户 ${u} 进入会话。` : `User ${u} entered demo session.`,
                        false);
        addLog("OK", "signin success (demo)");
      });
    });

    /* --------------------------
      Event log
    --------------------------- */
    const logBox = document.getElementById("log-box");
    let logPaused = false;
    let logTimer = null;

    function ts() {
      const d = new Date();
      return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    }

    function addLog(level, message) {
      const lvl = String(level).toUpperCase();
      const line = document.createElement("div");
      line.className = "log-line";
      const lvlClass = (lvl === "OK" ? "ok" : (lvl === "WARN" ? "warn" : (lvl === "ERR" ? "err" : "")));
      line.innerHTML = `<span class="t">${ts()}</span><span class="lvl ${lvlClass}">${escapeHtml(lvl)}</span> ${escapeHtml(message)}`;
      logBox.appendChild(line);
      if (!logPaused) {
        logBox.scrollTop = logBox.scrollHeight;
      }
    }

    function startLogStream() {
      if (logTimer) clearInterval(logTimer);
      logTimer = setInterval(() => {
        if (logPaused) return;
        const lang = currentLang();
        const samples = [
          { lvl: "INFO", msg: lang==="zh" ? "metrics scrape ok" : "metrics scrape ok" },
          { lvl: "OK",   msg: lang==="zh" ? "snapshot verified" : "snapshot verified" },
          { lvl: "INFO", msg: lang==="zh" ? "lan client connected" : "lan client connected" },
          { lvl: "WARN", msg: lang==="zh" ? "latency spike detected" : "latency spike detected" },
          { lvl: "INFO", msg: lang==="zh" ? "gc cycle completed" : "gc cycle completed" },
        ];
        const pick = samples[Math.floor(Math.random()*samples.length)];
        addLog(pick.lvl, pick.msg);

        // Occasionally emit a notification
        if (Math.random() < 0.12) {
          addNotification(
            lang==="zh" ? "状态更新" : "Status update",
            lang==="zh" ? "后台任务完成" : "Background task finished (demo)",
            true
          );
        }
      }, 1600);
    }

    document.getElementById("btn-log-pause").addEventListener("click", (e) => {
      logPaused = !logPaused;
      e.currentTarget.textContent = logPaused ? (currentLang()==="zh" ? "继续" : "Resume") : (currentLang()==="zh" ? "暂停" : "Pause");
      toast(currentLang()==="zh" ? "日志" : "Log", logPaused ? (currentLang()==="zh" ? "已暂停" : "Paused") : (currentLang()==="zh" ? "已继续" : "Resumed"), "ok", 1400);
    });

    document.getElementById("btn-log-clear").addEventListener("click", () => {
      logBox.innerHTML = "";
      toast(currentLang()==="zh" ? "日志" : "Log", currentLang()==="zh" ? "已清空" : "Cleared", "warn", 1400);
    });

    document.getElementById("btn-log-add").addEventListener("click", () => {
      const v = document.getElementById("log-input").value.trim();
      if (!v) return;
      addLog("INFO", v);
      document.getElementById("log-input").value = "";
    });

    document.getElementById("log-input").addEventListener("keydown", (e) => {
      if (e.key === "Enter") document.getElementById("btn-log-add").click();
    });

    /* --------------------------
      Helpers + init
    --------------------------- */
    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }
    function cryptoRandomId() {
      return Math.random().toString(16).slice(2) + Date.now().toString(16);
    }
    function currentLang() {
      return localStorage.getItem("lang") || "zh";
    }

    // ESC closes drawers
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { closeDrawer(); closeNotify(); }
    });

    // Init: theme/lang
    const savedTheme = localStorage.getItem("theme");
    if (savedTheme === "light" || savedTheme === "dark") {
      document.documentElement.setAttribute("data-theme", savedTheme);
    }
    const savedLang = currentLang();
    document.getElementById("lang-select").value = savedLang;
    document.getElementById("lang-select").addEventListener("change", (e) => setLang(e.target.value));
    setLang(savedLang);

    // Init notifications + logs + table
    addNotification(savedLang==="zh" ? "欢迎" : "Welcome",
                    savedLang==="zh" ? "欢迎。" : "This is a demo notification center. Mark read or clear anytime.",
                    true);
    renderNotifications();

    renderTable();
    updatePageInfo();
    startLogStream();
    addLog("OK", savedLang==="zh" ? "console booted (demo)" : "console booted (demo)");
  </script>
</body>
</html>
