#melolFSrow .fs-card .fs-ov{position:absolute;inset:0;pointer-events:none;}
#melolFSrow .fs-card .fs-w{position:absolute;left:50%;top:30%;transform:translateX(-50%);white-space:nowrap;font-family:Montserrat,Arial,sans-serif;font-weight:900;color:#fff;text-shadow:1px 1px 2px rgba(0,0,0,.55);text-align:center;line-height:1;}
#melolFSrow .fs-card .fs-t{position:absolute;left:50%;top:42%;transform:translateX(-50%);white-space:nowrap;font-family:Montserrat,Arial,sans-serif;font-weight:900;color:rgba(255,255,255,.72);text-shadow:1px 1px 2px rgba(0,0,0,.5);text-align:center;line-height:1;}
#melolFSrow .fs-badge{position:absolute;top:4px;right:4px;background:#e63946;color:#fff;font:700 8px/1 Arial,sans-serif;padding:3px 5px;border-radius:6px;white-space:nowrap;z-index:3;box-shadow:0 1px 3px rgba(0,0,0,.3);}
#melolFSrow .fs-card.fs-ended{opacity:.55;filter:grayscale(.6);pointer-events:none;}
