    --------------------------- */
    const notifyBackdrop = document.getElementById("notify-backdrop");
    const notifyDrawer = document.getElementById("notify-drawer");
    const notifyList = document.getElementById("notify-list");
    const unreadBadge = document.getElementById("unread-badge");

    let notifications = []; // {id, title, body, time, unread}

    function openNotify() {
      notifyBackdrop.classList.add("open");
      notifyDrawer.classList.add("open");
      notifyBackdrop.setAttribute("aria-hidden", "false");
    }
    function closeNotify() {
      notifyBackdrop.classList.remove("open");
      notifyDrawer.classList.remove("open");
      notifyBackdrop.setAttribute("aria-hidden", "true");
    }
    document.getElementById("btn-notify")?.addEventListener("click", openNotify);
    document.getElementById("btn-close-notify")?.addEventListener("click", closeNotify);
    notifyBackdrop?.addEventListener("click", closeNotify);

    function updateUnreadBadge() {
      const unread = notifications.filter(n => n.unread).length;
      if (unread > 0) {
        unreadBadge.style.display = "inline-flex";
        unreadBadge.textContent = String(unread);
      } else {
        unreadBadge.style.display = "none";
      }
    }

    function renderNotifications() {
      notifyList.innerHTML = "";
      if (notifications.length === 0) {
        const empty = document.createElement("div");
        empty.className = "notify-item";
        empty.innerHTML = `<strong>—</strong><div class="meta"><span>${escapeHtml(currentLang() === "zh" ? "暂无通知" : "No notifications")}</span><span></span></div>`;
        notifyList.appendChild(empty);
        updateUnreadBadge();
        return;
      }
      notifications.slice().reverse().forEach(n => {
        const item = document.createElement("div");
        item.className = "notify-item" + (n.unread ? " unread" : "");
        item.innerHTML = `
          <div style="display:flex; justify-content:space-between; gap:10px;">
            <strong>${escapeHtml(n.title)}</strong>
            <button class="btn btn-ghost" style="padding:6px 10px;" data-mark="${n.id}">
              ${escapeHtml(currentLang() === "zh" ? (n.unread ? "已读" : "未读") : (n.unread ? "Read" : "Unread"))}
            </button>
          </div>
          <div style="margin-top:6px; color: var(--muted);">${escapeHtml(n.body)}</div>
          <div class="meta">
            <span>${escapeHtml(n.time)}</span>
            <span>${escapeHtml(n.unread ? (currentLang()==="zh"?"未读":"Unread") : (currentLang()==="zh"?"已读":"Read"))}</span>
          </div>
        `;
        item.querySelector("[data-mark]")?.addEventListener("click", () => {
          n.unread = !n.unread;
          renderNotifications();
        });
        notifyList.appendChild(item);
      });
      updateUnreadBadge();
    }

    function addNotification(title, body, unread = true) {
      notifications.push({
        id: cryptoRandomId(),
        title, body,
        time: new Date().toLocaleString(),
        unread
