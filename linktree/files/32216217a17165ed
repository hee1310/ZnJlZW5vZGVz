    /* --------------------------
      Clock + metrics
    --------------------------- */
    function pad(n) { return n < 10 ? "0" + n : "" + n; }

    function updateClockAndTraffic() {
      const now = new Date();
      const formatted =
        now.getFullYear() + "-" + pad(now.getMonth() + 1) + "-" + pad(now.getDate()) + " " +
        pad(now.getHours()) + ":" + pad(now.getMinutes()) + ":" + pad(now.getSeconds());

      const headerTime = document.getElementById("header-time");
      if (headerTime) headerTime.textContent = formatted;

      // bandwidth jitter
      const base = 118;
      const jitter = Math.floor(Math.random() * 10); // 0–9
      document.getElementById("traffic-val").textContent = (base + jitter) + " Mbps";

      // uptime demo
      const boot = new Date("2025-12-31T03:17:00Z");
      const diffSec = Math.max(0, Math.floor((now - boot) / 1000));
      const days = Math.floor(diffSec / 86400);
      const hours = Math.floor((diffSec % 86400) / 3600);
      const mins = Math.floor((diffSec % 3600) / 60);
      const uptimeStr = days + "d " + pad(hours) + "h " + pad(mins) + "m";
      const ut = document.getElementById("uptime-text");
      const utd = document.getElementById("uptime-text-desktop");
      if (ut) ut.textContent = uptimeStr;
      if (utd) utd.textContent = uptimeStr;

      // used simulate
      const usedBase = 842; // GB
      const usedJitter = (Math.random() * 3 - 1.5);
      const used = Math.max(0, usedBase + usedJitter);
      const pct = (used / 2400) * 100;
      document.getElementById("used-val").textContent = used.toFixed(1) + " GB";
      document.getElementById("used-extra").textContent = pct.toFixed(1) + "% of pool";
      document.getElementById("used-bar").style.width = Math.min(100, Math.max(0, pct)).toFixed(1) + "%";
    }
    updateClockAndTraffic();
    setInterval(updateClockAndTraffic, 1000);

