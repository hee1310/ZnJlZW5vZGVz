    return { stamp:stamp(year,mo,day,hh,mm), label:str.trim(), y:year, mo:mo, d:day, hh:hh, mm:mm };
  }

  // Now, as Central wall-clock integer (DST-safe via Intl).
  function nowStamp(){
    try{
      var p={};
      new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',hour12:false,
        year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'})
        .formatToParts(new Date()).forEach(function(x){p[x.type]=x.value;});
      var hh=(p.hour==='24'?0:+p.hour);
      return ((((+p.year*100+ +p.month)*100+ +p.day)*100+hh)*100+ +p.minute);
    }catch(e){
      var d=new Date();
      return ((((d.getFullYear()*100+(d.getMonth()+1))*100+d.getDate())*100+d.getHours())*100+d.getMinutes());
    }
  }

  // Central wall-clock components -> exact UTC instant (DST-safe). For the live countdown.
  function toDate(w){
    if(!w) return null;
    var guess=Date.UTC(w.y,w.mo,w.d,w.hh,w.mm);
    try{
      var p={};
      new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',hour12:false,
        year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit'})
        .formatToParts(new Date(guess)).forEach(function(x){p[x.type]=x.value;});
      var asUTC=Date.UTC(+p.year,+p.month-1,+p.day,(p.hour==='24'?0:+p.hour),+p.minute,+p.second);
      return new Date(guess-(asUTC-guess));
    }catch(e){ return new Date(guess); }
  }

  function fmtShort(w){ return w?(ABBR[w.mo]+' '+w.d):''; }

  function parseTxt(txt){
    var catalog=[], drops=[], sold=[], section=null, seen={};
    txt.split('\n').forEach(function(line){
      line=line.trim(); if(!line) return;
      if(line==='-CATALOG-'){ section='catalog'; return; }
      if(line==='-DROPS-'){ section='drops'; return; }
      if(line==='-SOLD-'){ section='sold'; return; }
      if(section==='catalog'){ catalog.push(line); return; }
      if(section==='sold'){ sold.push(line.toLowerCase()); return; }
      if(section==='drops'){
        var parts=line.split('|');
        var domain=(parts[0]||'').trim().toLowerCase(); if(!domain) return;
        if(seen[domain]) console.warn('Me.LOL drops: DUPLICATE domain in TXT ->', domain);
        seen[domain]=1;
        drops.push({ domain:domain, start:parseWhen(parts[1]), end:parseWhen(parts[2]) });
      }
    });
    return { catalog:catalog, drops:drops, sold:sold };
  }

  // 'upcoming' | 'live' | 'ended'
  function status(e){
    var now=nowStamp();
    if(e.start && now < e.start.stamp) return 'upcoming';
    if(e.end   && now >= e.end.stamp)  return 'ended';
    return 'live';
  }

  var _cache=null, _promise=null;
  function load(){
    if(_promise) return _promise;
    _promise=fetch(TXT_URL,{cache:'no-store'})
      .then(function(r){ return r.text(); })
      .then(function(t){ _cache=parseTxt(t); return _cache; })
      .catch(function(e){ console.log('Me.LOL drops fetch error:',e); _cache={catalog:[],drops:[],sold:[]}; return _cache; });
    return _promise;
  }

  window.MELOLDrops={
    TXT_URL:TXT_URL, load:load, parseTxt:parseTxt, parseWhen:parseWhen,
    nowStamp:nowStamp, toDate:toDate, fmtShort:fmtShort, status:status,
    findDrop:function(domain){
      if(!_cache) return null; domain=(domain||'').toLowerCase();
      for(var i=0;i<_cache.drops.length;i++){ if(_cache.drops[i].domain===domain) return _cache.drops[i]; }
      return null;
    }
  };
})();
</script>
<script>
