<script>
/* ===== ME.LOL V600: checkout funnel — kill dynamic checkout on product pages + ADDED! button state ===== */
(function(){
  if(!window.location.pathname.includes('/products/')) return;
  if(window.__melolFunnel) return; window.__melolFunnel=true;

  // 1) remove dynamic checkout nodes outright (CSS above hides them pre-JS; this keeps the DOM clean through morphs)
  function killDynCheckout(){
    document.querySelectorAll('.product-form .shopify-payment-button, .product-form shopify-accelerated-checkout, form[action*="/cart/add"] .shopify-payment-button, form[action*="/cart/add"] shopify-accelerated-checkout, .shop-pay-wallet-button').forEach(function(el){ el.remove(); });
  }
  killDynCheckout();
  setTimeout(killDynCheckout,400); setTimeout(killDynCheckout,1200);
  try{ new MutationObserver(function(){ killDynCheckout(); if(window._melolAddedState) flip(); }).observe(document.body,{childList:true,subtree:true}); }catch(e){}

  // 2) ADDED! state — flips after any successful /cart/add, reverts when the shopper changes anything
  function addBtns(){ return document.querySelectorAll('button[name="add"], .product-form__submit, button.add-to-cart-button'); }
  window._melolAddedState=false;
  /* V649: NEVER innerHTML a Horizon component's button — the sticky add-to-cart button
     contains ref="quantityDisplay", and wiping it makes Horizon's MutationObserver throw
     MissingRefError and KILLS the component (the bug that mauled order #1039's session).
     Instead we MOVE the original children into a hidden holder (refs stay alive in the
     subtree) and append our own label. Revert moves them back. */
  function flip(){
    window._melolAddedState=true;
    addBtns().forEach(function(b){
      if(b.dataset.melolAdded==='1'){
        if(b.querySelector('.melol-added-label')) return;   // healthy — skip
        b.dataset.melolAdded='';                            // Horizon morphed our label away — re-stash
      }
      b.dataset.melolAdded='1';
      b.classList.add('melol-added');
      var holder=document.createElement('span');
      holder.className='melol-orig-holder';
      holder.style.display='none';
      while(b.firstChild) holder.appendChild(b.firstChild);
      b.appendChild(holder);
      var lab=document.createElement('span');
      lab.className='melol-added-label';
      lab.textContent='\u2713 ADDED! Go see what\u2019s in the cart \u2192';
      b.appendChild(lab);
      b.style.setProperty('background','#16a34a','important');
      b.style.setProperty('background-color','#16a34a','important');
      b.style.setProperty('border-color','#16a34a','important');
      b.style.setProperty('color','#fff','important');
    });
  }
  function revert(){
    if(!window._melolAddedState) return;
    window._melolAddedState=false;
    addBtns().forEach(function(b){
      if(b.dataset.melolAdded!=='1') return;
      b.dataset.melolAdded='';
      b.classList.remove('melol-added');
      var lab=b.querySelector(':scope > .melol-added-label');
      if(lab) lab.remove();
      var holder=b.querySelector(':scope > .melol-orig-holder');
      if(holder){ while(holder.firstChild) b.appendChild(holder.firstChild); holder.remove(); }
      b.style.removeProperty('background');
      b.style.removeProperty('background-color');
      b.style.removeProperty('border-color');
      b.style.removeProperty('color');
    });
  }

  // detect successful adds without touching the theme's add flow
  var _lastCount=null;
  var _fetch=window.fetch;
  function cartCount(cb){ _fetch('/cart.js',{headers:{Accept:'application/json'}}).then(function(r){return r.json();}).then(function(c){ cb(c&&typeof c.item_count==='number'?c.item_count:null); }).catch(function(){ cb(null); }); }
  function resync(){ cartCount(function(n){ if(n!==null) _lastCount=n; }); }
  resync();

  // path A: hook fetch — handle string, URL object, and Request inputs
  window.fetch=function(){
    var a0=arguments[0]; var url=(a0&&a0.url)?a0.url:String(a0||'');
    var p=_fetch.apply(this,arguments);
    if(url.indexOf('/cart/add')>-1){
      p.then(function(r){ if(r&&r.ok){ setTimeout(flip,150); setTimeout(resync,600); } }).catch(function(){});
    }
    return p;
  };
  // path B: hook XHR — some theme components add via XMLHttpRequest
  try{
    var _open=XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open=function(m,u){
      try{ if(String(u||'').indexOf('/cart/add')>-1){ this.addEventListener('load',function(){ if(this.status>=200&&this.status<300){ setTimeout(flip,150); setTimeout(resync,600); } }); } }catch(e){}
      return _open.apply(this,arguments);
    };
  }catch(e){}
  // path C: guaranteed fallback — after any Add click, watch the cart count climb
  document.addEventListener('click',function(e){
    var b=e.target&&e.target.closest&&e.target.closest('button[name="add"], .product-form__submit, button.add-to-cart-button');
    if(!b||b.dataset.melolAdded==='1') return;
    var tries=0;
    var iv=setInterval(function(){
      tries++;
      cartCount(function(n){
        if(n!==null&&_lastCount!==null&&n>_lastCount){ _lastCount=n; clearInterval(iv); flip(); }
        else if(n!==null&&_lastCount===null){ _lastCount=n; }
      });
      if(tries>10) clearInterval(iv);
    },450);
  },true);

  // ADDED state: the big button now goes to the cart (capture phase beats Shopify's own handler)
  document.addEventListener('click',function(e){
    var b=e.target&&e.target.closest&&e.target.closest('button[name="add"], .product-form__submit, button.add-to-cart-button');
    if(!b||b.dataset.melolAdded!=='1') return;
    e.preventDefault(); e.stopImmediatePropagation();
    window.location.href='/cart';
  },true);

  // any adjustment (size, finger, style, domain text) = they're configuring a new shirt -> revert
  document.addEventListener('change',function(e){
    if(e.target&&e.target.tagName==='INPUT'&&!e.target.closest('#melolSearchOverlay')) revert();
  },true);
  document.addEventListener('input',function(e){
    if(e.target&&e.target.name==='properties[Domain name on shirt]') revert();
  },true);
})();
</script>
