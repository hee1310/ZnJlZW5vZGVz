    startLabel=entry.start?entry.start.label:'';
    lock();
    _apply=setInterval(function(){ if(gated){ buyButtons().forEach(function(b){ if(b.style.display!=='none') b.style.setProperty('display','none','important'); }); buildPanel(); } },500);
    if(mode==='upcoming'){ _count=setInterval(tick,1000); tick(); }   // ended never self-unlocks
  });
})();
