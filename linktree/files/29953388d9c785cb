    }

    // upcoming
    box.style.cssText='margin:14px 0;padding:16px;border:2px solid #e63946;border-radius:14px;background:#fff5f5;font-family:Inter,Arial,sans-serif;text-align:center;';
    box.innerHTML=
      '<div style="font-size:15px;font-weight:800;color:#b91c1c;">🔒 Not dropped yet</div>'+
      '<div style="font-size:13px;color:#7f1d1d;margin-top:4px;">'+target.toUpperCase()+' goes live '+startLabel+' Central.</div>'+
      '<div id="melolDropCountdown" style="font:800 22px/1.1 Inter,Arial,sans-serif;color:#111;margin:10px 0 4px;letter-spacing:.5px;">—</div>'+
      '<button type="button" id="melolDropNotify" style="margin-top:6px;background:#e63946;color:#fff;border:none;border-radius:10px;padding:11px 18px;font-weight:700;font-size:14px;cursor:pointer;">🔔 Notify me when it drops</button>';
    anchor.parentNode.insertBefore(box,anchor);
    box.querySelector('#melolDropNotify').addEventListener('click',function(){
      var inp=document.querySelector('input[type=email]');
      if(inp){ inp.scrollIntoView({behavior:'smooth',block:'center'}); try{inp.focus();}catch(e){} }
      else { window.location.href='/collections/all'; }
    });
  }

  function tick(){
    var cd=document.getElementById('melolDropCountdown'); if(!cd) return;
    if(!startDate){ cd.textContent=''; return; }
    var ms=startDate.getTime()-Date.now();
    if(ms<=0){ unlock(); return; }
    var s=Math.floor(ms/1000), d=Math.floor(s/86400), h=Math.floor(s%86400/3600), m=Math.floor(s%3600/60), ss=s%60;
    cd.textContent=(d>0?d+'d ':'')+pad(h)+':'+pad(m)+':'+pad(ss);
  }

  function lock(){
    gated=true; window.MELOL_GATED=true;
    buyButtons().forEach(function(b){ b.style.setProperty('display','none','important'); });
    buildPanel();
  }
  function unlock(){
    gated=false; window.MELOL_GATED=false;
    var box=document.getElementById('melolDropGate'); if(box) box.remove();
    buyButtons().forEach(function(b){ b.style.removeProperty('display'); });
    if(_apply) clearInterval(_apply); if(_count) clearInterval(_count);
  }

  // belt-and-suspenders: swallow buy clicks while gated
  document.addEventListener('click',function(e){
    if(!gated) return;
    if(e.target&&e.target.closest&&e.target.closest('button[name="add"], .product-form__submit, .add-to-cart-button, .shopify-payment-button, [data-shopify="payment-button"], shopify-accelerated-checkout')){
      e.preventDefault(); e.stopImmediatePropagation();
