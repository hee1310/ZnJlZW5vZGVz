<script>
/* ===== PIECE 4 — SIZE MEMORY (product page): remember last size, restore on switch, FLASH so they see it held ===== */
(function(){
  if(location.pathname.indexOf('/products/')!==0) return;
  if(window.__melolSizeMem) return; window.__melolSizeMem=true;
  var SIZES={'XS':1,'S':1,'M':1,'L':1,'XL':1,'2XL':1,'3XL':1};

  function sizeRadios(){
    // Horizon size radios: variant_picker radios whose value is a size token
    var out=[], rs=document.querySelectorAll('input[type=radio]');
    for(var i=0;i<rs.length;i++){ var v=(rs[i].value||'').trim().toUpperCase(); if(SIZES[v]) out.push(rs[i]); }
    return out;
  }
  function checkedSize(){ var rs=sizeRadios(); for(var i=0;i<rs.length;i++){ if(rs[i].checked) return (rs[i].value||'').trim().toUpperCase(); } return ''; }
  function saved(){ try{ return (sessionStorage.getItem('melol_size')||'').trim().toUpperCase(); }catch(e){ return ''; } }
  function save(v){ try{ if(v) sessionStorage.setItem('melol_size', v); }catch(e){} }

  function flash(radio){
    var lab = radio.closest('label') || radio.parentElement; if(!lab) return;
    lab.classList.remove('melol-size-flash'); void lab.offsetWidth; lab.classList.add('melol-size-flash');
    setTimeout(function(){ lab.classList.remove('melol-size-flash'); }, 4200);
  }

  function restore(){
    var want=saved(); if(!want) return;
    var cur=checkedSize();
    if(cur===want){ return; }                 // already correct, no flash-spam
    var rs=sizeRadios();
    for(var i=0;i<rs.length;i++){
      if((rs[i].value||'').trim().toUpperCase()===want){
        if(!rs[i].checked){ rs[i].click(); }
        flash(rs[i]);                          // flash so they SEE the size held
        return;
      }
    }
  }

  // record every genuine size pick
  document.addEventListener('change',function(e){
    var el=e.target; if(!el||el.type!=='radio') return;
    var v=(el.value||'').trim().toUpperCase(); if(SIZES[v] && el.checked){ save(v); }
  },true);
  // also catch clicks on the size labels (Horizon sometimes fires click before change settles)
  document.addEventListener('click',function(e){
    var lab=e.target.closest&&e.target.closest('label'); if(!lab) return;
    var r=lab.querySelector('input[type=radio]'); if(!r) return;
    var v=(r.value||'').trim().toUpperCase(); if(SIZES[v]){ setTimeout(function(){ if(r.checked) save(v); },60); }
  },true);

  // restore on load + after Horizon re-renders (mirrors the finger-restore timing)
  var tries=0, iv=setInterval(function(){ tries++; restore(); if(tries>16) clearInterval(iv); },300);
  setTimeout(restore,800); setTimeout(restore,1600);
  try{ new MutationObserver(function(){ restore(); }).observe(document.body,{childList:true,subtree:true}); }catch(e){}
})();
</script>
