<script>
/* ===== ME.LOL — sweeper: disable card links for upcoming+ended drops V533.1 ===== */
(function(){
  if(!window.MELOLDrops) return;
  if(window.__melolSweep) return; window.__melolSweep=true;
  var PRODUCT='/products/put-it-on-a-free-shirt';

  function domFromHref(href){
    if(!href) return '';
    var m=href.match(/[?&]domain=([^&]+)/); if(!m) return '';
    try{ return decodeURIComponent(m[1]).toLowerCase(); }catch(e){ return m[1].toLowerCase(); }
  }
  function neutralize(a,label,color){
    if(a.getAttribute('data-melol-dead')) return;
    a.setAttribute('data-melol-dead','1');
    a.style.position='relative';
    a.style.pointerEvents='none';
    a.style.opacity='0.55';
    a.style.filter='grayscale(0.6)';
    var tag=document.createElement('div');
    tag.textContent=label;
    tag.style.cssText='position:absolute;top:-8px;left:-8px;background:'+color+';color:#fff;font:700 9px/1 Arial,sans-serif;padding:3px 6px;border-radius:10px;white-space:nowrap;z-index:5;pointer-events:none;';
    a.appendChild(tag);
  }
  function sweep(){
    var links=document.querySelectorAll('a[href*="'+PRODUCT+'"][href*="domain="]');
    for(var i=0;i<links.length;i++){
      var a=links[i], dom=domFromHref(a.getAttribute('href')||'');
      if(!dom) continue;
      if(a.getAttribute('data-melol-featured')) continue;   // ← featured strip handles its own status; don't grey it
      var entry=window.MELOLDrops.findDrop(dom); if(!entry) continue; // not a drop -> leave alone
      var st=window.MELOLDrops.status(entry);
      if(st==='ended')         neutralize(a,'ENDED','#6b7280');
      else if(st==='upcoming') neutralize(a,'SOON','#e63946');
      // live -> stays clickable
    }
  }
  window.MELOLDrops.load().then(function(){
    sweep();
    var t=0, iv=setInterval(function(){ t++; sweep(); if(t>40) clearInterval(iv); },400);
    try{ new MutationObserver(sweep).observe(document.body,{childList:true,subtree:true}); }catch(e){}
  });
})();
</script>
