<script>
(function(){
  if(location.pathname.indexOf('/products/')!==0) return;
  if(window.__melolFeaturedStrip) return; window.__melolFeaturedStrip=true;
  if(!window.MELOLDrops) return;

  var PRODUCT='/products/put-it-on-a-free-shirt', MB=749;
  var SHIRT_IMG='https://cdn.shopify.com/s/files/1/0714/1697/1451/files/FinalFlatShirt.png';

  function curDomain(){
    try{ var p=new URLSearchParams(location.search).get('domain'); return (p||sessionStorage.getItem('melol_domain')||'me.lol').toLowerCase(); }
    catch(e){ return 'me.lol'; }
  }

  // Build one shirt-only card (no bottom text). badge = '' for live, or 'SOON'/'JUL 1' for upcoming.
  function card(domain, badge, ended){
    var ld=domain.lastIndexOf('.');
    var w=(ld>=0?domain.slice(0,ld):domain).toUpperCase();
    var t=(ld>=0?domain.slice(ld):'').toUpperCase();
    if(t==='.WTF'||t==='.SO'||t==='.TO') t+='?';
    // fit the word to the 84px card: shrink for long words so it never overflows
    var fs=Math.min(17,Math.max(8,Math.round(84*0.22/Math.max(w.length*0.58,1))));
    var a=document.createElement('a');
    a.className='fs-card'+(ended?' fs-ended':'');
    a.href=PRODUCT+'?domain='+encodeURIComponent(domain);
    a.setAttribute('data-melol-featured','1');     // mark so the sweeper can treat us deliberately
    var badgeHtml=badge?'<span class="fs-badge">'+badge+'</span>':'';
    a.innerHTML=
      badgeHtml+
      '<img class="fs-shirt" src="'+SHIRT_IMG+'" alt="">'+
      '<span class="fs-ov">'+
        '<span class="fs-w" style="font-size:'+fs+'px;">'+w+'</span>'+
        '<span class="fs-t" style="font-size:'+Math.max(7,Math.round(fs*0.5))+'px;">'+t+'</span>'+
      '</span>';
    return a;
  }

  function anchorFor(mobile){
    if(mobile){                                    // phone: under the shirt image, above Your Shirts
      var mg=document.querySelector('media-gallery, .product-media-container, .product__media-wrapper, .product-media');
      if(mg && mg.getBoundingClientRect().width>0){
        return {host: mg.closest('media-gallery, .product-media-container, .product__media-wrapper')||mg, where:'after'};
      }
    } else {                                       // PC: info column under the free-explainer, above Your Shirts
      var ex=document.getElementById('melol-free-explainer'); if(ex) return {host:ex, where:'after'};
      var h1=document.querySelector('h1'); var blk=h1?(h1.closest('.text-block')||h1.parentElement):null;
      if(blk) return {host:blk, where:'after'};
    }
    var h1b=document.querySelector('h1'); var b2=h1b?(h1b.closest('.text-block')||h1b.parentElement):null;
    return b2?{host:b2,where:'after'}:null;
  }

  function build(data){
    var cur=curDomain();
    var mobile=window.innerWidth<=MB, mode=mobile?'m':'d';

    // Assemble the list: live drops first (badge JUST DROPPED), then catalog, with upcoming drops badged SOON.
    // Build a status map from the drops so catalog entries that are also drops get the right treatment.
    var items=[]; var seen={};
    function push(domain, badge, ended){
      domain=(domain||'').toLowerCase();
      if(!domain || domain===cur || domain==='me.lol' || seen[domain]) return;  // skip current + me.lol + dupes
      seen[domain]=1; items.push({domain:domain, badge:badge||'', ended:!!ended});
    }

    // upcoming + live drops first
    (data.drops||[]).forEach(function(e){
      var st=window.MELOLDrops.status(e);
      if(st==='upcoming'){ var when=window.MELOLDrops.fmtShort(e.start)||'SOON'; push(e.domain, when, false); }
      else if(st==='live'){ push(e.domain, 'JUST DROPPED', false); }
      // ended drops: skip from featured (don't surface dead drops)
    });
    // then the curated catalog
    (data.catalog||[]).forEach(function(d){ push(d, '', false); });

    if(!items.length) return;

    // de-dupe-render guard: only rebuild if the set or viewport mode changed
    var sig=mode+'|'+cur+'|'+items.map(function(i){return i.domain+':'+i.badge;}).join(',');
    var ex=document.getElementById('melolFeaturedStrip');
    if(ex){ if(ex.getAttribute('data-sig')===sig) return; ex.remove(); }

    var a=anchorFor(mobile); if(!a||!a.host||!a.host.parentNode) return;

    var box=document.createElement('div'); box.id='melolFeaturedStrip'; box.setAttribute('data-sig',sig);
    box.innerHTML='<div class="fs-label">\u2728 Featured Shirts <small>tap below to grab one \u00b7 <span class="fs-search">search our catalog</span></small></div><div id="melolFSrow"></div>';
    var srch=box.querySelector('.fs-search');
    if(srch) srch.addEventListener('click',function(e){ e.stopPropagation(); e.preventDefault(); if(window.__melolOpenCatalogSearch) window.__melolOpenCatalogSearch(); });
    if(a.where==='after') a.host.parentNode.insertBefore(box, a.host.nextSibling);
    else a.host.parentNode.insertBefore(box, a.host);

    var row=box.querySelector('#melolFSrow');
    items.forEach(function(it){ row.appendChild(card(it.domain, it.badge, it.ended)); });
  }

  function run(){
    window.MELOLDrops.load().then(function(data){
      build(data);
      var n=0, iv=setInterval(function(){ n++; build(data); if(n>20) clearInterval(iv); }, 300);
      try{ new MutationObserver(function(){ build(data); }).observe(document.body,{childList:true,subtree:true}); }catch(e){}
      // refresh when drops cross start/end while the page sits open
      setInterval(function(){ build(data); }, 20000);
      var _rt; window.addEventListener('resize',function(){ clearTimeout(_rt); _rt=setTimeout(function(){ build(data); },150); });
    });
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',run); else setTimeout(run,400);
})();
</script>
