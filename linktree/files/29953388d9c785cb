<script>
(function(){
  if(location.pathname.indexOf('/products/')!==0) return;
  if(window.__melolRadioRage) return; window.__melolRadioRage=true;
  var TAPS=[], WINDOW=2500, TRIGGER=3, COOLDOWN=6000, lastFire=0;
  function isOptionRadio(t){
    var r=(t.matches&&t.matches('input[type=radio]'))?t:((t.closest&&t.closest('label'))?t.closest('label').querySelector('input[type=radio]'):null);
