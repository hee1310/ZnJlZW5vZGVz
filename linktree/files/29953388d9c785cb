<script>
/* PRODUCT PAGE: keep a hidden properties[Graphic] input in sync so the ORDER plainly shows the graphic. */
(function(){
  if(location.pathname.indexOf('/products/')!==0) return;
  if(window.__melolGraphicProp) return; window.__melolGraphicProp=true;
  var GRAPHIC_NAME={'usa.lol':'the dumpster fire'};
  function curDomain(){
    try{ var m=(location.search||'').match(/[?&]domain=([^&]+)/); if(m) return decodeURIComponent(m[1]).trim().toLowerCase(); }catch(e){}
    try{ return (sessionStorage.getItem('melol_domain')||'me.lol').toLowerCase(); }catch(e){ return 'me.lol'; }
  }
  function sync(){
    var b=document.querySelector('button[name="add"],.product-form__submit'); if(!b) return;
    var f=b.closest('form'); if(!f) return;
    var dom=curDomain(), gname=GRAPHIC_NAME[dom]||'';
    var inp=f.querySelector('input[name="properties[Graphic]"]');
    // "shown" = the finger/graphic add-on variant is selected (read the ADD-ON radio, stable)
    var shown=false;
    // add-on radios live in the VARIANT PICKER form, not the buy form — detect document-wide
    var addonR=document.querySelectorAll('input[type=radio]');
    for(var s=0;s<addonR.length;s++){ var nm=(addonR[s].name||'').toLowerCase(); if((nm.indexOf('add-on')>-1||nm.indexOf('addon')>-1)&&addonR[s].checked){ var vv=(addonR[s].value||'').toLowerCase(); if(vv.indexOf('finger')>-1||vv.indexOf('pointing')>-1) shown=true; break; } }
    // manage the misleading Finger style inputs: when a graphic is active, take them out of submission
    // by clearing their NAME (so nothing is posted) but keep them enabled so the UI still works.
    // radios live OUTSIDE the form (associated via the form="" attribute), so scope
    // document-wide and filter by real form ownership — f.querySelectorAll can't see them
    var styleR=Array.prototype.filter.call(document.querySelectorAll('input[name="properties[Finger style]"], input[data-melol-fs-off]'),function(el){ return el.form===f; });
    function fsOff(){ for(var q=0;q<styleR.length;q++){ var el=styleR[q]; if(el.name){ el.setAttribute('data-melol-fs-name', el.name); el.setAttribute('data-melol-fs-off','1'); el.removeAttribute('name'); } } }
    function fsOn(){ for(var q2=0;q2<styleR.length;q2++){ var el2=styleR[q2]; var orig=el2.getAttribute('data-melol-fs-name'); if(orig){ el2.setAttribute('name',orig); el2.removeAttribute('data-melol-fs-off'); el2.removeAttribute('data-melol-fs-name'); } } }
    if(gname && shown){
      if(!inp){ inp=document.createElement('input'); inp.type='hidden'; inp.name='properties[Graphic]'; f.appendChild(inp); }
      inp.value=gname;
      fsOff();
    } else if(shown){
      fsOn();                                     // real finger selected: style MUST post with the order
      if(inp){ inp.parentNode.removeChild(inp); }
    } else {
      // V600 LEAK FIX: finger removed -> de-name the style radios. Dynamic checkout
      // ("Buy with Shop" / "More payment options") serializes the RAW form, so a
      // named+checked style radio rides into the order even on the $19.97 variant.
      // No name = nothing posted = fulfillment sees a clean no-finger order.
      fsOff();
      if(inp){ inp.parentNode.removeChild(inp); }
    }
  }
  sync();
  var n=0,iv=setInterval(function(){ n++; sync(); if(n>40) clearInterval(iv); },300);
  document.addEventListener('change',function(e){ if(e.target&&e.target.name==='properties[Finger style]') setTimeout(sync,30); },true);
  document.addEventListener('click',function(){ setTimeout(sync,60); },true);
  try{ new MutationObserver(sync).observe(document.body,{childList:true,subtree:true}); }catch(e){}
})();
</script>
