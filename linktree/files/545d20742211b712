eco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":8,"contentRating":100,"bundleId":"com.R3Studio.ChuteiOS"}}},{"$kind":"Lockup","adamId":"6758235178","bundleId":"com.argsment.Anywhere","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.5294117647058824,"green":0.7568627450980392,"blue":1,"type":"rgb"},"textColor":{"red":0.08235294117647059,"green":0.08627450980392157,"blue":0.08627450980392157,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/90/7b/05/907b05a0-3482-e0c5-54b4-135fa2cbfc2a/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Anywhere Proxy","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Powerful Native Proxy Client","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Powerful Native Proxy Client","ageRating":"4+","productDescription":"Your internet, Anywhere — fast, private, and beautifully simple.\n\nAnywhere is the proxy client your Apple devices deserve. No clunky wrappers, no bloated cross-platform shells — just a clean, native app built from the ground up in Swift, designed to feel like it belongs on your device. Because it does.\n\nTraveling abroad, working remotely, or simply wanting a more private way to browse? Anywhere connects you in a single tap, then quietly gets out of your way.\n\n---\n\nWHY ANYWHERE\n\n• One tap and you're on. No menus to dig through, no dashboards to decode — open the app, tap once, done.\n\n• Fast by nature. Built natively in Swift, Anywhere launches in a blink, sips battery, and moves your traffic with the speed only a true native app can deliver.\n\n• Every connection takes the right path. Smart routing rules send traffic through your server when it needs protection and straight to the internet when it doesn't — so pages load faster and videos stream smoother.\n\n• Made for where you are. Heading home for the holidays? Country Bypass keeps your local apps running at full speed while everything else stays protected.\n\n• Ads, gone. Purify blocks ads at the network level — across your browser, your apps, and your favorite streaming services. No extensions required.\n\n---\n\nEVERYWHERE YOU ARE\n\n• iPhone and iPad, with one-tap toggles right in Control Center\n• Apple TV, as a full native app for the living room\n• Apple Watch, so you can connect and switch setups from your wrist\n\n---\n\nA FULL TOOLKIT, BEAUTIFULLY ORGANIZED\n\n• Import a subscription from a link or a quick QR scan\n• Test server latency with a single tap\n• Link servers into chains for advanced setups\n• Always On VPN, for protection that never sleeps\n• Deep, flexible routing rules for power users\n• Capture and inspect traffic with the built-in MITM tools\n\n---\n\nWORKS WITH WHAT YOU HAVE\n\nAnywhere speaks the protocols you already use — VLESS (with Vision and Reality), Hysteria2, Shadowsocks, Trojan, AnyTLS, and more. If your provider hands you a subscription link, Anywhere takes it from there.\n\n---\n\nPRIVACY YOU CAN TRUST\n\nYour traffic flows through your servers — never ours. We don't see it, we don't log it, we don't want it. And Anywhere is open source under GPLv3, so anyone can verify exactly what we do — and what we don't.\n\n---\n\nBUILT BY PEOPLE WHO CARE\n\nWe made Anywhere because we were tired of proxy apps that felt like homework. So we built the one we wanted to use: native, thoughtful, and polished down to details you can feel the moment it opens.\n\n---\n\nDownload Anywhere — and see what a proxy client can be when it's truly made for the device in your hand.","rating":4.8,"ratingCount":"52","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{