  function inView(el){ if(!el) return true; var r=el.getBoundingClientRect(); return r.top>=0 && r.bottom<=window.innerHeight; }
  function toast(msg, anchorEl){
    var t=document.getElementById('melolRageToast');
    if(!t){ t=document.createElement('div'); t.id='melolRageToast';
      t.style.cssText='position:fixed;z-index:100000;left:50%;transform:translateX(-50%);background:#0a66ff;color:#fff;font:700 14px/1.35 Inter,Arial,sans-serif;padding:12px 18px;border-radius:13px;max-width:300px;text-align:center;box-shadow:0 10px 32px rgba(10,102,255,.4);opacity:0;transition:opacity .18s ease;pointer-events:none;';
      document.body.appendChild(t); }
